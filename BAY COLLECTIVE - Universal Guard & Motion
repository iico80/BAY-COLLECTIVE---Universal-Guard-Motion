        end)
    end

    -- تحميل المنطقة حول لاعب غير محمّل
    function BC.EnsureLoaded(plr, timeout)
        local _, hrp = parts(plr)
        if hrp then return hrp end
        local pos = BC.LastPos[plr]
        if pos then task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(pos, 3) end) end) end
        local t0 = os.clock()
        while os.clock() - t0 < timeout and BC.Alive do
            local _, h = parts(plr)
            if h then return h end
            task.wait(0.15)
        end
    end

    function BC.TeleportTo(plr)
        if not plr or not plr.Parent then return end
        local _, me = BC.GetChar()
        if not me then return end
        local _, hrp0 = parts(plr)
        if not hrp0 then BC.Notify("انتقال", "عم نحمّل المنطقة حوالين " .. plr.DisplayName .. "...", T.Gold) end
        task.spawn(function()
            local hrp = BC.EnsureLoaded(plr, 6)
            local _, myhrp = BC.GetChar()
            if not myhrp then return end
            if hrp then
                myhrp.AssemblyLinearVelocity = Vector3.zero
                myhrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 3)
                BC.Notify("انتقال", "وصلنا عند " .. plr.DisplayName, T.Green)
            elseif BC.LastPos[plr] then
                myhrp.AssemblyLinearVelocity = Vector3.zero
                myhrp.CFrame = CFrame.new(BC.LastPos[plr] + Vector3.new(0, 5, 0))
                BC.Notify("انتقال", "رحنا لآخر موقع معروف إله.", T.Gold)
            else
                BC.Notify("انتقال", "موقعه مجهول وما انشاف قبل.", T.Red)
                return
            end
            if State.Anchor then State.Locked = myhrp.CFrame end
        end)
    end

    -- ===== شريط المشاهدة =====
    local hud = New("Frame", {
        Size = UDim2.fromOffset(260, 40), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14),
        BackgroundColor3 = T.Panel, BorderSizePixel = 0, Visible = false, ZIndex = 50,
    }, BC.Gui)
    Round(hud, 6)
    local hudStroke = Stroke(hud, T.A1, 1, 0.2)
    local hudName = New("TextLabel", {
        Size = UDim2.new(1, -116, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = "",
        Font = T.Font, TextSize = 11, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 51,
    }, hud)
    local function hbtn(txt, x, col)
        local b = New("TextButton", {
            Size = UDim2.fromOffset(30, 28), Position = UDim2.new(1, x, 0.5, -14), BackgroundColor3 = T.Item,
            Text = txt, Font = T.Font, TextSize = 13, TextColor3 = col, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 51,
        }, hud)
        Round(b, 4)
        return b
    end
    local hPrev, hNext, hStop = hbtn("<", -104, T.A1), hbtn(">", -70, T.A1), hbtn("X", -36, T.Red)

    function BC.StopSpectate(silent)
        BC.SpecToken = (BC.SpecToken or 0) + 1
        local was = State.Spectating
        State.Spectating = nil
        hud.Visible = false
        local cam = workspace.CurrentCamera
        local _, _, hum = BC.GetChar()
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end
        if was and not silent then BC.Notify("المشاهدة", "رجعت الكاميرا إلك.", T.Green) end
    end

    function BC.Spectate(plr)
        if not plr or plr == LP or not plr.Parent then return end
        BC.StopSpectate(true)
        State.Spectating = plr
        BC.SpecToken = (BC.SpecToken or 0) + 1
        local token = BC.SpecToken
        hud.Visible = true
        task.spawn(function()
            local lastReq = 0
            while BC.Alive and State.Spectating == plr and BC.SpecToken == token do
                local cam = workspace.CurrentCamera
                local _, hrp, hum = parts(plr)
                local _, me = BC.GetChar()
                if hrp and hum then
                    if cam.CameraSubject ~= hum then cam.CameraSubject = hum end
                    if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
                    BC.LastPos[plr] = hrp.Position
                    hudName.Text = plr.DisplayName .. ((me and ("  •  " .. math.floor((hrp.Position - me.Position).Magnitude) .. "م")) or "")
                    hudName.TextColor3 = T.Text
                elseif BC.LastPos[plr] then
                    local pos = BC.LastPos[plr]
                    cam.CameraType = Enum.CameraType.Scriptable
                    cam.CFrame = CFrame.lookAt(pos + Vector3.new(0, 10, 18), pos)
                    hudName.Text = plr.DisplayName .. "  •  عم يتحمّل..."
                    hudName.TextColor3 = T.Gold
                    if os.clock() - lastReq > 2.5 then
                        lastReq = os.clock()
                        task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(pos, 2) end) end)
                    end
                else
                    hudName.Text = plr.DisplayName .. "  •  موقعه مجهول"
                    hudName.TextColor3 = T.Red
                end
                task.wait(0.1)
            end
        end)
        BC.Notify("المشاهدة", "عم تشوف " .. plr.DisplayName, T.Violet)
    end
    BC.Track(hStop.MouseButton1Click:Connect(function() BC.StopSpectate() end))
    BC.OnCleanup(function() BC.StopSpectate(true) end)

    -- ===== الصفحة =====
    local page = UI.AddTab("players", "PLR")
    UI.Section(page, "اللاعبين")
    local rebuild
    local search = UI.Input(page, "ابحث بالاسم...", nil, function() if rebuild then rebuild() end end)

    local card = New("Frame", { Size = UDim2.new(1, 0, 0, 92), BackgroundColor3 = T.Item, BorderSizePixel = 0 }, page)
    Round(card, 4)
    local cardStroke = Stroke(card, T.A1, 1, 0.4)
    UI.Reg(cardStroke, "Color")
    local cImg = New("ImageLabel", {
        Size = UDim2.fromOffset(72, 72), Position = UDim2.new(1, -80, 0.5, -36), BackgroundColor3 = T.Bg, BorderSizePixel = 0,
    }, card)
    Round(cImg, 6)
    local function cl(y, size, font, col)
        return New("TextLabel", {
            Size = UDim2.new(1, -96, 0, 16), Position = UDim2.fromOffset(8, y), BackgroundTransparency = 1, Text = "",
            Font = font, TextSize = size, TextColor3 = col, TextXAlignment = Enum.TextXAlignment.Right,
        }, card)
    end
    local cName, cUser = cl(10, 13, T.Font, T.Text), cl(30, 10, T.FontMid, T.SubText)
    local cAge, cState = cl(48, 10, T.FontMid, T.SubText), cl(66, 10, T.FontMid, T.Green)

    local function updateCard()
        local plr = State.Selected
        if not plr or not plr.Parent then
            State.Selected = nil
            cName.Text, cUser.Text, cAge.Text, cState.Text, cImg.Image = "اختار لاعب من القائمة", "", "", "", ""
            return
        end
        cName.Text = plr.DisplayName
        cUser.Text = "@" .. plr.Name .. "  •  ID " .. plr.UserId
        cAge.Text = "عمر الحساب: " .. plr.AccountAge .. " يوم" .. (plr.Team and ("  •  " .. plr.Team.Name) or "")
        local _, hrp, hum = parts(plr)
        local _, me = BC.GetChar()
        if hrp and me then
            cState.Text = ("محمّل • %d متر%s"):format(math.floor((hrp.Position - me.Position).Magnitude),
                hum and ("  •  صحة " .. math.floor(hum.Health)) or "")
            cState.TextColor3 = T.Green
        elseif BC.LastPos[plr] then
            cState.Text, cState.TextColor3 = "غير محمّل • آخر موقع معروف", T.Gold
        else
            cState.Text, cState.TextColor3 = "غير محمّل • الموقع مجهول", T.Red
        end
    end

    local function sel()
        if not State.Selected then
            BC.Notify("اللاعبين", "اختار لاعب من القائمة أول.", T.Gold)
            return nil
        end
        return State.Selected
    end
    local function others()
        local t = {}
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(t, p) end end
        table.sort(t, function(a, b) return a.Name:lower() < b.Name:lower() end)
        return t
    end
    function BC.CycleSpectate(dir)
        local t = others()
        if #t == 0 then return end
        local idx = table.find(t, State.Spectating or State.Selected) or 0
        idx = ((idx - 1 + dir) % #t) + 1
        State.Selected = t[idx]
        BC.Spectate(t[idx])
        updateCard()
        if rebuild then rebuild() end
    end
    BC.Track(hPrev.MouseButton1Click:Connect(function() BC.CycleSpectate(-1) end))
    BC.Track(hNext.MouseButton1Click:Connect(function() BC.CycleSpectate(1) end))

    UI.ButtonRow(page, {
        { "انتقال", function() local p = sel() if p then BC.TeleportTo(p) end end, T.Cyan },
        { "مشاهدة", function() local p = sel() if p then BC.Spectate(p) end end, T.Violet },
        { "إيقاف", function() BC.StopSpectate() end, T.Red },
    })
    UI.ButtonRow(page, {
        { "السابق", function() BC.CycleSpectate(-1) end, T.A1 },
        { "التالي", function() BC.CycleSpectate(1) end, T.A1 },
        { "نسخ الاسم", function()
            local p = sel()
            if p and setclipboard then setclipboard(p.Name) BC.Notify("اللاعبين", "اننسخ: " .. p.Name, T.Green)
            elseif p then BC.Notify("اللاعبين", "الـ executor ما بيدعم النسخ.", T.Red) end
        end, T.Gold },
    })

    local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, page)
    New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
    local rows = {}

    rebuild = function()
        for _, r in pairs(rows) do r.btn:Destroy() end
        rows = {}
        local q = (search.Text or ""):lower()
        local list = {}
        for _, p in ipairs(others()) do
            if q == "" or p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true) then
                table.insert(list, p)
            end
        end
        if #list == 0 then
            rows.empty = { btn = New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "ما في لاعبين", Font = T.FontMid,
                TextSize = 11, TextColor3 = T.SubText,
            }, holder) }
            return
        end
        for i, p in ipairs(list) do
            local btn = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = T.Item, Text = "", AutoButtonColor = false,
                BorderSizePixel = 0, LayoutOrder = i,
            }, holder)
            Round(btn, 4)
            local st = Stroke(btn, State.Selected == p and T.A1 or T.Stroke)
            local av = New("ImageLabel", {
                Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, -40, 0.5, -17), BackgroundColor3 = T.Bg, BorderSizePixel = 0,
            }, btn)
            Round(av, 17)
            thumb(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100, function(img) av.Image = img end)
            New("TextLabel", {
                Size = UDim2.new(1, -116, 0, 18), Position = UDim2.fromOffset(68, 5), BackgroundTransparency = 1,
                Text = p.DisplayName, Font = T.Font, TextSize = 11, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Right,
            }, btn)
            New("TextLabel", {
                Size = UDim2.new(1, -116, 0, 14), Position = UDim2.fromOffset(68, 23), BackgroundTransparency = 1,
                Text = "@" .. p.Name, Font = T.FontMid, TextSize = 9, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Right,
            }, btn)
            local dist = New("TextLabel", {
                Size = UDim2.fromOffset(56, 18), Position = UDim2.fromOffset(8, 13), BackgroundTransparency = 1, Text = "",
                Font = T.Font, TextSize = 10, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Left,
            }, btn)
            rows[p] = { btn = btn, st = st, dist = dist }
            BC.Track(btn.MouseButton1Click:Connect(function()
                State.Selected = p
                for pp, r in pairs(rows) do
                    if r.st then r.st.Color = (pp == p) and T.A1 or T.Stroke end
                end
                updateCard()
                thumb(p.UserId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size150x150, function(img)
                    if State.Selected == p then cImg.Image = img end
                end)
            end))
        end
    end

    local pending = false
    local function queueRebuild()
        if pending then return end
        pending = true
        task.delay(0.25, function() pending = false if BC.Alive then rebuild() end end)
    end
    BC.Track(Players.PlayerAdded:Connect(queueRebuild))
    BC.Track(Players.PlayerRemoving:Connect(function(p)
        BC.LastPos[p] = nil
        if State.Selected == p then State.Selected = nil end
        if State.Spectating == p then
            BC.StopSpectate(true)
            BC.Notify("المشاهدة", p.DisplayName .. " طلع من السيرفر.", T.Gold)
        end
        queueRebuild()
        task.delay(0.3, updateCard)
    end))
    rebuild()
    updateCard()

    task.spawn(function()
        while BC.Alive do
            local _, me = BC.GetChar()
            for p, r in pairs(rows) do
                if r.dist then
                    local _, hrp = parts(p)
                    if hrp and me then
                        r.dist.Text, r.dist.TextColor3 = math.floor((hrp.Position - me.Position).Magnitude) .. "م", T.Green
                    elseif BC.LastPos[p] then
                        r.dist.Text, r.dist.TextColor3 = "بعيد", T.Gold
                    else
                        r.dist.Text, r.dist.TextColor3 = "؟", T.SubText
                    end
                end
            end
            updateCard()
            task.wait(0.6)
        end
    end)
end
-- [[ BAY COLLECTIVE v3 - PART 7/9: WORLD, ESP & VISUALS ]] --
do
    local S, UI, T, C, State, LP = BC.S, BC.UI, BC.Theme, BC.Config, BC.State, BC.LP
    local Players, RunService, UIS, Lighting = S.Players, S.Run, S.UIS, S.Light
    local New = BC.New

    BC.Orig = {
        Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd,
        GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
        Gravity = workspace.Gravity, FOV = workspace.CurrentCamera.FieldOfView,
    }
    local O = BC.Orig

    local function restoreLight()
        Lighting.Brightness, Lighting.FogEnd, Lighting.GlobalShadows = O.Brightness, O.FogEnd, O.GlobalShadows
        Lighting.Ambient, Lighting.OutdoorAmbient = O.Ambient, O.OutdoorAmbient
        if not C.TimeOn then Lighting.ClockTime = O.ClockTime end
    end
    function BC.RestoreWorld()
        restoreLight()
        Lighting.ClockTime = O.ClockTime
        workspace.Gravity = O.Gravity
        local cam = workspace.CurrentCamera
        if cam then cam.FieldOfView = O.FOV end
    end
    BC.OnCleanup(BC.RestoreWorld)

    -- ===== ESP =====
    local folder = New("Folder", { Name = "BC_ESP" }, BC.UiParent)
    BC.OnCleanup(function() folder:Destroy() end)
    local esp = {}
    local function clearESP(p)
        local e = esp[p]
        if e then
            e.hl:Destroy()
            e.bb:Destroy()
            esp[p] = nil
        end
    end
    local function buildESP(p, ch)
        local head = ch:FindFirstChild("Head")
        if not head then return end
        local col = (p == State.Selected) and T.Gold or T.A1
        local hl = New("Highlight", {
            Adornee = ch, FillColor = col, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.82,
            OutlineTransparency = 0.2, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        }, folder)
        local bb = New("BillboardGui", {
            Adornee = head, Size = UDim2.fromOffset(150, 30), StudsOffset = Vector3.new(0, 2.6, 0), AlwaysOnTop = true,
        }, folder)
        local lbl = New("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = T.Font, TextSize = 12, TextColor3 = col,
            TextStrokeTransparency = 0.4, Text = p.DisplayName,
        }, bb)
        esp[p] = { hl = hl, bb = bb, lbl = lbl, char = ch }
    end

    task.spawn(function()
        while BC.Alive do
            local _, me = BC.GetChar()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local ch, e = p.Character, esp[p]
                    if C.ESP and ch and ch:FindFirstChild("Head") then
                        if e and (e.char ~= ch or not e.hl.Parent) then clearESP(p) e = nil end
                        if not e then buildESP(p, ch) e = esp[p] end
                        if e then
                            local col = (p == State.Selected) and T.Gold or T.A1
                            e.hl.FillColor, e.lbl.TextColor3, e.bb.Enabled = col, col, C.ESPNames
                            local hrp = ch:FindFirstChild("HumanoidRootPart")
                            e.lbl.Text = p.DisplayName .. ((me and hrp) and (" [" .. math.floor((hrp.Position - me.Position).Magnitude) .. "م]") or "")
                        end
                    elseif e then
                        clearESP(p)
                    end
                end
            end
            for p in pairs(esp) do if not p.Parent then clearESP(p) end end
            task.wait(0.3)
        end
    end)

    -- ===== فرض القيم =====
    task.spawn(function()
        while BC.Alive do
            if C.FullBright then
                Lighting.Brightness, Lighting.GlobalShadows, Lighting.FogEnd = 2, false, 1e6
                Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180), Color3.fromRGB(180, 180, 180)
                if not C.TimeOn then Lighting.ClockTime = 14 end
            end
            if C.TimeOn then Lighting.ClockTime = C.Time end
            if C.GravOn then workspace.Gravity = C.Grav end
            task.wait(0.3)
        end
    end)
    BC.Track(RunService.RenderStepped:Connect(function()
        if C.FOVOn then
            local cam = workspace.CurrentCamera
            if cam and cam.FieldOfView ~= C.FOV then cam.FieldOfView = C.FOV end
        end
    end))

    -- ===== انتقال بلمسة =====
    local function tpTo(pos)
        local _, hrp = BC.GetChar()
        if not hrp or State.Anchor then return end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0)) * (hrp.CFrame - hrp.CFrame.Position)
    end
    local function castFrom(ray)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { LP.Character }
        local res = workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
        if res then tpTo(res.Position) end
    end
    BC.Track(UIS.TouchTap:Connect(function(positions, processed)
        if processed or not C.TapTP then return end
        local p, cam = positions[1], workspace.CurrentCamera
        if p and cam then castFrom(cam:ScreenPointToRay(p.X, p.Y)) end
    end))
    BC.Track(UIS.InputBegan:Connect(function(input, processed)
        if processed or not C.TapTP or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not UIS:IsKeyDown(Enum.KeyCode.LeftControl) then return end
        local m, cam = UIS:GetMouseLocation(), workspace.CurrentCamera
        castFrom(cam:ViewportPointToRay(m.X, m.Y))
    end))

    -- ===== الصفحة =====
    local world = UI.AddTab("world", "WLD")
    UI.Section(world, "الرؤية (ESP)")
    UI.CfgToggle(world, "إظهار اللاعبين من ورا الجدران", "ESP", T.Gold)
    UI.CfgToggle(world, "إظهار الأسماء والمسافات", "ESPNames", T.A1)
    UI.Section(world, "الإضاءة والوقت")
    UI.CfgToggle(world, "إضاءة كاملة (Fullbright)", "FullBright", T.Green, function(v) if not v then restoreLight() end end)
    UI.CfgToggle(world, "تثبيت الوقت", "TimeOn", T.Violet, function(v) if not v then Lighting.ClockTime = O.ClockTime end end)
    UI.Slider(world, "الساعة (0 - 24)", "Time", 0, 24, 0.5, nil, T.Violet)
    UI.Section(world, "الكاميرا والفيزياء")
    UI.CfgToggle(world, "تغيير زاوية الكاميرا (FOV)", "FOVOn", T.Cyan, function(v)
        if not v then workspace.CurrentCamera.FieldOfView = O.FOV end
    end)
    UI.Slider(world, "قيمة الـ FOV", "FOV", 30, 120, 1, nil, T.Cyan)
    UI.CfgToggle(world, "تغيير الجاذبية", "GravOn", T.Red, function(v) if not v then workspace.Gravity = O.Gravity end end)
    UI.Slider(world, "قيمة الجاذبية", "Grav", 10, 400, 1, nil, T.Red)
    UI.Section(world, "الانتقال")
    UI.CfgToggle(world, "انتقال بلمسة عالأرض (Tap Teleport)", "TapTP", T.Gold)
    UI.Label(world, "على الجوال: لمسة وحدة عالمكان. على الكمبيوتر: Ctrl + كليك.")
end
-- [[ BAY COLLECTIVE v3 - PART 8/9: TOOLS, SETTINGS & INFO ]] --
do
    local S, UI, T, C, State, LP = BC.S, BC.UI, BC.Theme, BC.Config, BC.State, BC.LP
    local RunService = S.Run
    local New = BC.New

    -- ===== شريط FPS و Ping =====
    local Stats = New("TextLabel", {
        Size = UDim2.fromOffset(120, 22), Position = UDim2.new(1, -130, 0, 8), BackgroundColor3 = T.Panel,
        BackgroundTransparency = 0.15, Text = "FPS -- | -- ms", Font = T.Font, TextSize = 10, TextColor3 = T.Green,
        BorderSizePixel = 0, Visible = C.ShowStats,
    }, BC.Gui)
    BC.Round(Stats, 4)
    BC.Stroke(Stats, T.A1, 1, 0.5)
    local frames = 0
    BC.Track(RunService.RenderStepped:Connect(function() frames += 1 end))
    task.spawn(function()
        while BC.Alive do
            task.wait(0.5)
            if Stats.Visible then
                local fps, ping = frames * 2, 0
                frames = 0
                pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end)
                Stats.Text = ("FPS %d | %d ms"):format(fps, ping)
                Stats.TextColor3 = (fps >= 45) and T.Green or (fps >= 25 and T.Cyan or T.Red)
            else
                frames = 0
            end
        end
    end)

    -- ===== دوال =====
    local function resetAll()
        BC.ResetConfig()
        State.Anchor, State.Locked = false, nil
        BC.RestoreSpeed()
        BC.RestoreJump()
        BC.StopFly()
        BC.StopNoclip()
        BC.RestoreWorld()
        Stats.Visible = C.ShowStats
        UI.ApplyTheme()
        UI.ApplyScale()
        BC.RefreshAll()
        BC.Notify("BAY COLLECTIVE", "رجعنا كل شي للوضع الافتراضي.", T.Red)
    end

    function BC.ImportJSON(raw)
        if BC.ApplyJSON(raw) then
            BC.Save()
            Stats.Visible = C.ShowStats
            UI.ApplyTheme()
            UI.ApplyScale()
            BC.RefreshAll()
            BC.Notify("الإعدادات", "انستوردت الإعدادات بنجاح.", T.Green)
        else
            BC.Notify("الإعدادات", "النص مو صحيح.", T.Red)
        end
    end

    -- ===== الأدوات =====
    local tools = UI.AddTab("tools", "TLS")
    UI.Section(tools, "حماية ذكية")
    UI.CfgToggle(tools, "منع السقوط بالفراغ", "AntiVoid", T.Green)
