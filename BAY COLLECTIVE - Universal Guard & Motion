-- [[ BAY COLLECTIVE v3 - PART 1/9: CORE, THEME, SAVE & CLEANUP ]] --
local BC = {
    Conns = {}, Hooks = {}, Alive = true, Ready = false, Version = "3.0",
    SaveFile = "BayCollective_v3.json", LastPos = {}, Base = {}, Refreshers = {},
}

do
    BC.S = {
        Players = game:GetService("Players"), Run = game:GetService("RunService"),
        Tween = game:GetService("TweenService"), UIS = game:GetService("UserInputService"),
        Http = game:GetService("HttpService"), Light = game:GetService("Lighting"),
    }
    local S = BC.S
    BC.LP = S.Players.LocalPlayer

    if getgenv and type(getgenv().BayCollectiveCleanup) == "function" then
        pcall(getgenv().BayCollectiveCleanup)
    end

    BC.Palettes = {
        { Name = "نيون",  A = Color3.fromRGB(0, 229, 255),  B = Color3.fromRGB(138, 92, 255) },
        { Name = "زمرد",  A = Color3.fromRGB(70, 255, 170), B = Color3.fromRGB(0, 170, 255) },
        { Name = "ناري",  A = Color3.fromRGB(255, 170, 50), B = Color3.fromRGB(255, 60, 110) },
        { Name = "وردي",  A = Color3.fromRGB(255, 110, 220), B = Color3.fromRGB(120, 90, 255) },
    }

    BC.Theme = {
        Bg = Color3.fromRGB(8, 10, 18), Panel = Color3.fromRGB(14, 17, 29),
        Item = Color3.fromRGB(20, 24, 40), Stroke = Color3.fromRGB(38, 46, 74),
        Cyan = Color3.fromRGB(0, 229, 255), Violet = Color3.fromRGB(138, 92, 255),
        Green = Color3.fromRGB(70, 255, 170), Red = Color3.fromRGB(255, 80, 110),
        Gold = Color3.fromRGB(255, 200, 70), Text = Color3.fromRGB(232, 238, 255),
        SubText = Color3.fromRGB(140, 152, 190),
        Font = Enum.Font.GothamBold, FontMid = Enum.Font.GothamMedium,
        A1 = Color3.fromRGB(0, 229, 255), A2 = Color3.fromRGB(138, 92, 255),
    }

    BC.Defaults = {
        Speed = 24, Jump = 50, FlySpeed = 60, FOV = 70, Grav = 196, Time = 14,
        UIScale = 1, Theme = 1, PosX = 0.5, PosY = 0.1,
        SpeedOn = false, JumpOn = false, InfJump = false, Shield = false, Guard = false,
        Noclip = false, Fly = false, TapTP = false, ESP = false, ESPNames = true,
        FullBright = false, FOVOn = false, GravOn = false, TimeOn = false,
        AntiVoid = true, AntiAFK = true, ShowStats = false, SkipIntro = false,
    }
    BC.Config = {}
    for k, v in pairs(BC.Defaults) do BC.Config[k] = v end

    function BC.ApplyJSON(raw)
        local ok, data = pcall(S.Http.JSONDecode, S.Http, raw)
        if not ok or type(data) ~= "table" then return false end
        for k, def in pairs(BC.Defaults) do
            if type(data[k]) == type(def) then BC.Config[k] = data[k] end
        end
        return true
    end

    function BC.Load()
        local raw
        if isfile and readfile then
            pcall(function() if isfile(BC.SaveFile) then raw = readfile(BC.SaveFile) end end)
        end
        if not raw and getgenv then raw = getgenv().BC_SAVED_JSON end
        if raw then BC.LoadedFromSave = BC.ApplyJSON(raw) end
    end

    local function writeNow()
        local ok, json = pcall(S.Http.JSONEncode, S.Http, BC.Config)
        if not ok then return end
        if getgenv then getgenv().BC_SAVED_JSON = json end
        if writefile then pcall(writefile, BC.SaveFile, json) end
    end
    BC.Flush = writeNow

    local queued = false
    function BC.Save()
        if queued then return end
        queued = true
        task.delay(0.5, function()
            queued = false
            if BC.Alive then writeNow() end
        end)
    end

    function BC.ResetConfig()
        for k, v in pairs(BC.Defaults) do BC.Config[k] = v end
        BC.Save()
    end

    BC.Load()
    do
        local pal = BC.Palettes[math.clamp(BC.Config.Theme, 1, #BC.Palettes)]
        BC.Theme.A1, BC.Theme.A2 = pal.A, pal.B
    end

    function BC.Track(c) table.insert(BC.Conns, c) return c end
    function BC.OnCleanup(fn) table.insert(BC.Hooks, fn) end
    function BC.Safe(fn, ...)
        local ok, err = pcall(fn, ...)
        if not ok then warn("[BayCollective] " .. tostring(err)) end
        return ok
    end
    function BC.Tween(obj, t, props, style, dir)
        local tw = S.Tween:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
        tw:Play()
        return tw
    end
    function BC.Clamp(n, lo, hi, fb)
        n = tonumber(n)
        if not n or n ~= n then return fb end
        return math.clamp(n, lo, hi)
    end
    function BC.GetChar()
        local ch = BC.LP.Character
        if not ch then return end
        return ch, ch:FindFirstChild("HumanoidRootPart"), ch:FindFirstChildOfClass("Humanoid")
    end

    -- حاوية الواجهة
    local function GetUiParent()
        local ok, h = pcall(function() return gethui and gethui() end)
        if ok and h then return h end
        if pcall(function() return game:GetService("CoreGui").Name end) then return game:GetService("CoreGui") end
        return BC.LP:WaitForChild("PlayerGui")
    end
    BC.UiParent = GetUiParent()
    local old = BC.UiParent:FindFirstChild("BayCollective_V3")
    if old then old:Destroy() end

    BC.Gui = Instance.new("ScreenGui")
    BC.Gui.Name = "BayCollective_V3"
    BC.Gui.ResetOnSpawn = false
    BC.Gui.IgnoreGuiInset = true
    BC.Gui.DisplayOrder = 999
    BC.Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    BC.Gui.Parent = BC.UiParent

    function BC.Cleanup()
        if not BC.Alive then return end
        BC.Alive = false
        for _, fn in ipairs(BC.Hooks) do pcall(fn) end
        pcall(BC.Flush)
        for _, c in ipairs(BC.Conns) do pcall(function() c:Disconnect() end) end
        table.clear(BC.Conns)
        table.clear(BC.Hooks)
        pcall(function() BC.Gui:Destroy() end)
        if getgenv then getgenv().BayCollectiveCleanup = nil end
    end

    if getgenv then
        getgenv().BayCollectiveCleanup = BC.Cleanup
        getgenv().BC = BC
    end
end
-- [[ BAY COLLECTIVE v3 - PART 2/9: UI LIBRARY ]] --
do
    local S, T, LP = BC.S, BC.Theme, BC.LP
    local UIS, RunService = S.UIS, S.Run
    local C = BC.Config
    local UI = {}
    BC.UI = UI
    BC.State = { Anchor = false, Locked = nil, SafePos = nil, Spectating = nil, Selected = nil, Slots = {} }

    function BC.RefreshAll()
        for _, fn in ipairs(BC.Refreshers) do pcall(fn) end
    end
    function BC.New(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        if parent then o.Parent = parent end
        return o
    end
    local New = BC.New
    function BC.Round(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r or 4) }, o) end
    function BC.Stroke(o, col, th, tr)
        return New("UIStroke", {
            Color = col or T.Stroke, Thickness = th or 1, Transparency = tr or 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, o)
    end
    local Round, Stroke = BC.Round, BC.Stroke

    function BC.IsPointer(i)
        return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
    end
    function BC.IsMove(i)
        return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
    end

    UI.Acc = {}
    function UI.Reg(o, prop) table.insert(UI.Acc, { o, prop }) end

    -- سحب مخصص مع حدود الشاشة
    function UI.MakeDraggable(handle, target, onTap, onEnd)
        local dragging, startPt, startPos, moved = false, nil, nil, 0
        BC.Track(handle.InputBegan:Connect(function(input)
            if not BC.IsPointer(input) then return end
            dragging, moved = true, 0
            startPt, startPos = input.Position, target.AbsolutePosition
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    c:Disconnect()
                    if moved < 8 then
                        if onTap then onTap() end
                    elseif onEnd then
                        onEnd()
                    end
                end
            end)
        end))
        BC.Track(UIS.InputChanged:Connect(function(input)
            if not dragging or not BC.IsMove(input) then return end
            local d = input.Position - startPt
            moved = math.max(moved, d.Magnitude)
            local vs, sz = BC.Gui.AbsoluteSize, target.AbsoluteSize
            target.Position = UDim2.fromOffset(
                math.clamp(startPos.X + d.X, 0, math.max(0, vs.X - sz.X)),
                math.clamp(startPos.Y + d.Y, 0, math.max(0, vs.Y - sz.Y)))
        end))
    end

    -- ===== النافذة =====
    local vs = BC.Gui.AbsoluteSize
    if vs.X < 50 then vs = workspace.CurrentCamera.ViewportSize end
    local W, H = math.min(372, vs.X - 16), math.min(340, vs.Y - 24)

    local Main = New("Frame", {
        Name = "Main", Size = UDim2.fromOffset(W, H),
        Position = UDim2.fromOffset(
            math.clamp(C.PosX * vs.X, 0, math.max(0, vs.X - W)),
            math.clamp(C.PosY * vs.Y, 0, math.max(0, vs.Y - H))),
        BackgroundColor3 = T.Bg, BackgroundTransparency = 0.05, BorderSizePixel = 0,
        ClipsDescendants = true, Active = true, Visible = false,
    }, BC.Gui)
    Round(Main, 6)
    local MainStroke = Stroke(Main, Color3.new(1, 1, 1), 1.8)
    local StrokeGrad = New("UIGradient", {}, MainStroke)
    local MainScale = New("UIScale", { Scale = C.UIScale }, Main)

    -- جزيئات خلفية
    local particles = {}
    for i = 1, 16 do
        local x, y = math.random(0, W), math.random(0, H)
        local f = New("Frame", {
            Size = UDim2.fromOffset(2, 2), Position = UDim2.fromOffset(x, y),
            BackgroundColor3 = T.A1, BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 0,
        }, Main)
        particles[i] = { f = f, x = x, y = y, s = math.random(8, 26) }
    end

    -- الهيدر
    local Header = New("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Panel, BorderSizePixel = 0 }, Main)
    local Dot = New("Frame", {
        Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 12, 0.5, -4),
        BackgroundColor3 = T.Green, BorderSizePixel = 0,
    }, Header)
    Round(Dot, 4)
    New("TextLabel", {
        Size = UDim2.new(1, -120, 0, 18), Position = UDim2.fromOffset(28, 3), BackgroundTransparency = 1,
        Text = "BAY COLLECTIVE", Font = T.Font, TextSize = 12, TextColor3 = T.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, Header)
    New("TextLabel", {
        Size = UDim2.new(1, -120, 0, 12), Position = UDim2.fromOffset(28, 20), BackgroundTransparency = 1,
        Text = "SYSTEM ONLINE  //  V" .. BC.Version, Font = T.FontMid, TextSize = 8, TextColor3 = T.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, Header)
    local MinBtn = New("TextButton", {
        Size = UDim2.fromOffset(30, 22), Position = UDim2.new(1, -38, 0.5, -11), BackgroundColor3 = T.Item,
        Text = "-", Font = T.Font, TextSize = 16, TextColor3 = T.Text, AutoButtonColor = false, BorderSizePixel = 0,
    }, Header)
    Round(MinBtn, 4)
    local HLine = New("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = T.A1, BackgroundTransparency = 0.5, BorderSizePixel = 0,
    }, Header)
    UI.Reg(HLine, "BackgroundColor3")
    UI.MakeDraggable(Header, Main, nil, function()
        local p, v = Main.AbsolutePosition, BC.Gui.AbsoluteSize
        C.PosX, C.PosY = p.X / math.max(1, v.X), p.Y / math.max(1, v.Y)
        BC.Save()
    end)

    -- الشريط الجانبي والمحتوى
    local Sidebar = New("ScrollingFrame", {
        Size = UDim2.new(0, 46, 1, -37), Position = UDim2.fromOffset(0, 37), BackgroundColor3 = T.Panel,
        BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
    }, Main)
    New("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, Sidebar)
    New("UIPadding", { PaddingTop = UDim.new(0, 6) }, Sidebar)
    local Content = New("Frame", {
        Size = UDim2.new(1, -58, 1, -45), Position = UDim2.fromOffset(54, 41),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, Main)

    local Scan = New("Frame", {
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = T.A1, BackgroundTransparency = 0.92,
        BorderSizePixel = 0, ZIndex = 20,
    }, Main)
    UI.Reg(Scan, "BackgroundColor3")

    -- ===== التبويبات =====
    UI.Pages, UI.TabBtns, UI.Active = {}, {}, nil
    function UI.Select(id)
        UI.Active = id
        for pid, page in pairs(UI.Pages) do
            local on = (pid == id)
            page.Visible = on
            local tb = UI.TabBtns[pid]
            tb.Bar.Visible = on
            BC.Tween(tb.Btn, 0.2, { TextColor3 = on and T.A1 or T.SubText, BackgroundTransparency = on and 0 or 1 })
        end
    end
    function UI.AddTab(id, glyph)
        local b = New("TextButton", {
            Size = UDim2.fromOffset(38, 38), BackgroundColor3 = T.Item, BackgroundTransparency = 1,
            Text = glyph, Font = T.Font, TextSize = 9, TextColor3 = T.SubText,
            AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = #Sidebar:GetChildren(),
        }, Sidebar)
        Round(b, 4)
        local bar = New("Frame", {
            Size = UDim2.new(0, 3, 0.6, 0), Position = UDim2.new(0, 0, 0.2, 0),
            BackgroundColor3 = T.A1, BorderSizePixel = 0, Visible = false,
        }, b)
        UI.Reg(bar, "BackgroundColor3")
        local page = New("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = T.A1, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false,
        }, Content)
        New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
        New("UIPadding", { PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 4) }, page)
        UI.Pages[id] = page
        UI.TabBtns[id] = { Btn = b, Bar = bar }
        BC.Track(b.MouseButton1Click:Connect(function() UI.Select(id) end))
        if not UI.Active then UI.Select(id) end
        return page
    end

    -- ===== فتح وتسكير =====
    UI.IsOpen = false
    function UI.ApplyScale() MainScale.Scale = (UI.IsOpen and 1 or 0.9) * C.UIScale end
    function UI.Open(open)
        UI.IsOpen = open
        if open then
            Main.Visible = true
            MainScale.Scale = 0.9 * C.UIScale
            BC.Tween(MainScale, 0.28, { Scale = C.UIScale }, Enum.EasingStyle.Back)
        else
            local tw = BC.Tween(MainScale, 0.16, { Scale = 0.9 * C.UIScale }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tw.Completed:Once(function() if not UI.IsOpen then Main.Visible = false end end)
        end
    end
    BC.Track(MinBtn.MouseButton1Click:Connect(function() UI.Open(false) end))

    -- الزر العايم
    local Float = New("TextButton", {
        Name = "Float", Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(12, vs.Y * 0.4),
        BackgroundColor3 = T.Panel, Text = "BC", Font = T.Font, TextSize = 13, TextColor3 = T.A1,
        AutoButtonColor = false, BorderSizePixel = 0, Visible = false,
    }, BC.Gui)
    Round(Float, 10)
    UI.Reg(Float, "TextColor3")
    local FloatStroke = Stroke(Float, Color3.new(1, 1, 1), 1.8)
    local FloatGrad = New("UIGradient", {}, FloatStroke)
    UI.MakeDraggable(Float, Float, function() UI.Open(not UI.IsOpen) end)
    UI.Float, UI.Main = Float, Main

    -- ===== الثيم =====
    function UI.ApplyTheme()
        local pal = BC.Palettes[math.clamp(C.Theme, 1, #BC.Palettes)]
        T.A1, T.A2 = pal.A, pal.B
        local seq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, pal.A), ColorSequenceKeypoint.new(0.5, pal.B), ColorSequenceKeypoint.new(1, pal.A),
        })
        StrokeGrad.Color, FloatGrad.Color = seq, seq
        for _, p in ipairs(particles) do p.f.BackgroundColor3 = pal.A end
        for _, r in ipairs(UI.Acc) do
            if r[1] and r[1].Parent then r[1][r[2]] = pal.A end
        end
        UI.Select(UI.Active)
    end

    -- أنيميشن موحد
    local t0 = os.clock()
    BC.Track(RunService.RenderStepped:Connect(function(dt)
        local t = os.clock() - t0
        local rot = (t * 70) % 360
        StrokeGrad.Rotation, FloatGrad.Rotation = rot, rot
        Dot.BackgroundTransparency = 0.3 + 0.3 * math.sin(t * 4)
        if Main.Visible then
            Scan.Position = UDim2.new(0, 0, 0, (t * 60) % H)
            for _, p in ipairs(particles) do
                p.y -= p.s * dt
                if p.y < -4 then p.y, p.x = H + 4, math.random(0, W) end
                p.f.Position = UDim2.fromOffset(p.x, p.y)
            end
        end
    end))

    -- ===== الإشعارات =====
    local Host = New("Frame", {
        Size = UDim2.fromOffset(270, 200), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8),
        BackgroundTransparency = 1, ZIndex = 200,
    }, BC.Gui)
    New("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, Host)
    local live, toastN = {}, 0
    function BC.Notify(title, msg, col)
        if not BC.Alive then return end
        col = col or T.A1
        toastN += 1
        local g = New("CanvasGroup", {
            Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.Panel, BorderSizePixel = 0,
            GroupTransparency = 1, LayoutOrder = toastN,
        }, Host)
        Round(g, 5)
        Stroke(g, col, 1, 0.4)
        New("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = col, BorderSizePixel = 0 }, g)
        New("TextLabel", {
            Size = UDim2.new(1, -18, 0, 14), Position = UDim2.fromOffset(10, 4), BackgroundTransparency = 1,
            Text = title, Font = T.Font, TextSize = 10, TextColor3 = col, TextXAlignment = Enum.TextXAlignment.Right,
        }, g)
        New("TextLabel", {
            Size = UDim2.new(1, -18, 0, 16), Position = UDim2.fromOffset(10, 19), BackgroundTransparency = 1,
            Text = msg, Font = T.FontMid, TextSize = 11, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Right,
        }, g)
        BC.Tween(g, 0.25, { GroupTransparency = 0 })
        table.insert(live, g)
        if #live > 3 then
            local o = table.remove(live, 1)
            if o.Parent then o:Destroy() end
        end
        task.delay(2.6, function()
            if g.Parent then
                local tw = BC.Tween(g, 0.3, { GroupTransparency = 1 })
                tw.Completed:Once(function()
                    local i = table.find(live, g)
                    if i then table.remove(live, i) end
                    g:Destroy()
                end)
            end
        end)
    end

    UI.ApplyTheme()
end
-- [[ BAY COLLECTIVE v3 - PART 3/9: WIDGETS ]] --
do
    local S, UI, T, C = BC.S, BC.UI, BC.Theme, BC.Config
    local UIS = S.UIS
    local New, Round, Stroke = BC.New, BC.Round, BC.Stroke

    function UI.Section(page, text)
        local f = New("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1 }, page)
        local ln = New("Frame", {
            Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = T.A1, BackgroundTransparency = 0.7, BorderSizePixel = 0,
        }, f)
        local lb = New("TextLabel", {
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = T.Bg, BorderSizePixel = 0,
            Text = "  " .. text .. "  ", Font = T.Font, TextSize = 10, TextColor3 = T.A1,
        }, f)
        UI.Reg(ln, "BackgroundColor3")
        UI.Reg(lb, "TextColor3")
        return f
    end

    function UI.Label(page, text)
        return New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            Text = text, Font = T.FontMid, TextSize = 11, TextColor3 = T.SubText, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.15,
        }, page)
    end

    function UI.Toggle(page, text, get, set, accent)
        accent = accent or T.Cyan
        local row = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Item, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
        }, page)
        Round(row, 4)
        local st = Stroke(row)
        New("TextLabel", {
            Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(56, 0), BackgroundTransparency = 1,
            Text = text, Font = T.FontMid, TextSize = 11, TextColor3 = T.Text,
            TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = true,
        }, row)
        local track = New("Frame", {
            Size = UDim2.fromOffset(36, 18), Position = UDim2.new(0, 10, 0.5, -9), BackgroundColor3 = T.Bg, BorderSizePixel = 0,
        }, row)
        Round(track, 9)
        local knob = New("Frame", {
            Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = T.SubText, BorderSizePixel = 0,
        }, track)
        Round(knob, 6)
        local obj = {}
        function obj.Refresh()
            local on = get() and true or false
            BC.Tween(track, 0.2, { BackgroundColor3 = on and accent or T.Bg })
            BC.Tween(knob, 0.2, {
                Position = on and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
                BackgroundColor3 = on and Color3.new(1, 1, 1) or T.SubText,
            })
            BC.Tween(st, 0.2, { Color = on and accent or T.Stroke })
        end
        BC.Track(row.MouseButton1Click:Connect(function()
            BC.Safe(set, not get())
            obj.Refresh()
        end))
        obj.Refresh()
        table.insert(BC.Refreshers, obj.Refresh)
        return obj
    end

    function UI.CfgToggle(page, text, key, accent, cb)
        return UI.Toggle(page, text, function() return C[key] end, function(v)
            C[key] = v
            BC.Save()
            if cb then cb(v) end
        end, accent)
    end

    function UI.Slider(page, text, key, min, max, step, cb, accent)
        accent = accent or T.Violet
        step = step or 1
        local row = New("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = T.Item, BorderSizePixel = 0 }, page)
        Round(row, 4)
        Stroke(row)
        New("TextLabel", {
