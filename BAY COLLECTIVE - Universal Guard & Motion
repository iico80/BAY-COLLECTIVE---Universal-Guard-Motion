            return b
        end
        local minus = mini("-", 8)
        local box = New("TextBox", {
            Size = UDim2.fromOffset(44, 22), Position = UDim2.fromOffset(36, 6), BackgroundColor3 = T.Panel,
            Text = "", Font = T.Font, TextSize = 11, TextColor3 = T.Text, ClearTextOnFocus = false, BorderSizePixel = 0,
        }, row)
        Round(box, 4)
        Stroke(box, accent, 1, 0.5)
        local plus = mini("+", 84)
        local hit = New("Frame", { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 36), BackgroundTransparency = 1 }, row)
        local track = New("Frame", {
            Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0.5, -3), BackgroundColor3 = T.Bg, BorderSizePixel = 0,
        }, hit)
        Round(track, 3)
        local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = accent, BorderSizePixel = 0 }, track)
        Round(fill, 3)
        local knob = New("Frame", { Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
        Round(knob, 6)

        local obj = {}
        local function paint()
            local v = C[key]
            local a = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(a, 0, 1, 0)
            knob.Position = UDim2.new(a, -6, 0.5, -6)
            if not box:IsFocused() then box.Text = ("%g"):format(v) end
        end
        local function set(v)
            v = BC.Clamp(v, min, max, C[key])
            v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
            C[key] = v
            BC.Save()
            paint()
            if cb then BC.Safe(cb, v) end
        end
        obj.Set, obj.Refresh = set, paint

        local function fromX(x)
            local a, w = track.AbsolutePosition.X, math.max(1, track.AbsoluteSize.X)
            return min + (max - min) * math.clamp((x - a) / w, 0, 1)
        end
        local dragging = false
        BC.Track(hit.InputBegan:Connect(function(input)
            if not BC.IsPointer(input) then return end
            dragging = true
            page.ScrollingEnabled = false
            set(fromX(input.Position.X))
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    page.ScrollingEnabled = true
                    c:Disconnect()
                end
            end)
        end))
        BC.Track(UIS.InputChanged:Connect(function(input)
            if dragging and BC.IsMove(input) then set(fromX(input.Position.X)) end
        end))
        BC.Track(minus.MouseButton1Click:Connect(function() set(C[key] - step) end))
        BC.Track(plus.MouseButton1Click:Connect(function() set(C[key] + step) end))
        BC.Track(box.FocusLost:Connect(function() set(box.Text) end))
        paint()
        table.insert(BC.Refreshers, paint)
        return obj
    end

    function UI.Button(page, text, cb, accent)
        return UI.ButtonRow(page, { { text, cb, accent } })
    end

    function UI.ButtonRow(page, items)
        local n = #items
        local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }, page)
        New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, row)
        for i, it in ipairs(items) do
            local accent = it[3] or T.Text
            local b = New("TextButton", {
                Size = UDim2.new(1 / n, -(4 * (n - 1)) / n, 1, 0), BackgroundColor3 = T.Item, Text = it[1],
                Font = T.Font, TextSize = 10, TextColor3 = accent, AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i,
            }, row)
            Round(b, 4)
            Stroke(b, accent, 1, 0.65)
            BC.Track(b.MouseButton1Click:Connect(function()
                b.BackgroundColor3 = accent:Lerp(T.Item, 0.6)
                BC.Tween(b, 0.3, { BackgroundColor3 = T.Item })
                if it[2] then BC.Safe(it[2]) end
            end))
        end
        return row
    end

    function UI.Input(page, placeholder, onSubmit, onChange)
        local box = New("TextBox", {
            Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Item, Text = "", PlaceholderText = placeholder,
            PlaceholderColor3 = T.SubText, Font = T.FontMid, TextSize = 11, TextColor3 = T.Text,
            ClearTextOnFocus = false, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Right,
        }, page)
        Round(box, 4)
        Stroke(box, T.Stroke)
        New("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10) }, box)
        if onChange then
            BC.Track(box:GetPropertyChangedSignal("Text"):Connect(function() onChange(box.Text) end))
        end
        if onSubmit then
            BC.Track(box.FocusLost:Connect(function(enter) onSubmit(box.Text, enter) end))
        end
        return box
    end
end
