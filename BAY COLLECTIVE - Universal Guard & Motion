-- [[ BAY COLLECTIVE v3 - PART 9/9: ENGINE & LAUNCH ]] --
do
    local S, UI, T, C, State, LP = BC.S, BC.UI, BC.Theme, BC.Config, BC.State, BC.LP
    local Players, RunService, UIS = S.Players, S.Run, S.UIS

    -- ===== كاش تصادم اللاعبين =====
    local others = {}
    local function Watch(plr)
        if plr == LP then return end
        local function onChar(ch)
            local list = {}
            others[plr] = list
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then table.insert(list, p) end
            end
            BC.Track(ch.DescendantAdded:Connect(function(d)
                if d:IsA("BasePart") then table.insert(list, d) end
            end))
        end
        if plr.Character then onChar(plr.Character) end
        BC.Track(plr.CharacterAdded:Connect(onChar))
    end
    for _, p in ipairs(Players:GetPlayers()) do Watch(p) end
    BC.Track(Players.PlayerAdded:Connect(Watch))
    BC.Track(Players.PlayerRemoving:Connect(function(p) others[p] = nil end))

    BC.Track(RunService.Stepped:Connect(function()
        if not BC.Ready then return end
        if C.Noclip and LP.Character then
            for _, p in ipairs(LP.Character:GetChildren()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
        if C.Shield or State.Anchor then
            for _, list in pairs(others) do
                for i = #list, 1, -1 do
                    local p = list[i]
                    if not p.Parent then table.remove(list, i)
                    elseif p.CanCollide then p.CanCollide = false end
                end
            end
        end
    end))

    -- ===== تنظيف القوى (بدون ما نلمس المقاعد والمركبات) =====
    local function ClearForces(hrp, hum)
        if hum.SeatPart then return end
        for _, o in ipairs(hrp:GetChildren()) do
            if o:IsA("BodyAngularVelocity") or o:IsA("BodyVelocity") or o:IsA("BodyThrust") or o:IsA("BodyGyro")
                or o:IsA("BodyPosition") or o:IsA("AngularVelocity") or o:IsA("LinearVelocity") or o:IsA("VectorForce")
                or o:IsA("AlignPosition") or o:IsA("AlignOrientation") then
                o:Destroy()
            end
        end
    end

    -- ===== الحلقة الرئيسية =====
    local lastHum, lastSafe, warned = nil, 0, false

    local function Step()
        if not BC.Ready then return end
        local _, hrp, hum = BC.GetChar()
        if not (hrp and hum) or hum.Health <= 0 then return end

        if hum ~= lastHum then
            lastHum = hum
            BC.Base.Walk, BC.Base.JumpPower, BC.Base.JumpHeight = hum.WalkSpeed, hum.JumpPower, hum.JumpHeight
        end

        if C.Shield then
            ClearForces(hrp, hum)
            local v = hrp.AssemblyLinearVelocity
            if v.Magnitude > 80 and not C.Fly then
                local xz = Vector3.new(v.X, 0, v.Z)
                if xz.Magnitude > 65 then xz = xz.Unit * 65 end
                hrp.AssemblyLinearVelocity = Vector3.new(xz.X, math.clamp(v.Y, -95, 65), xz.Z)
            end
            if hrp.AssemblyAngularVelocity.Magnitude > 18 then hrp.AssemblyAngularVelocity = Vector3.zero end
        end

        if C.Guard then
            if hum.Sit then hum.Sit = false end
            if hum.PlatformStand then hum.PlatformStand = false end
            if hum.WalkSpeed <= 1 then hum.WalkSpeed = C.SpeedOn and C.Speed or (BC.Base.Walk or 16) end
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.Seated then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end

        if C.AntiVoid and not State.Anchor then
            local fh = workspace.FallenPartsDestroyHeight
            if fh == fh and fh > -1e5 and hrp.Position.Y < fh + 80 then
                local dest = State.SafePos or (BC.State.Slots and State.Slots[1])
                if dest then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.CFrame = dest
                end
            elseif hum.FloorMaterial ~= Enum.Material.Air and os.clock() - lastSafe > 0.5 then
                lastSafe = os.clock()
                State.SafePos = hrp.CFrame + Vector3.new(0, 3, 0)
            end
        end

        if State.Anchor and State.Locked then
            ClearForces(hrp, hum)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = State.Locked
            return
        end

        if C.Fly then
            local cam = workspace.CurrentCamera
            local cf = cam.CFrame
            local md = hum.MoveDirection
            local dir = Vector3.zero
            if md.Magnitude > 0.05 then
                local look = cf.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
                local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z).Unit
                dir = look * md:Dot(flat) + right * md:Dot(right)
            end
            if hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
            if dir.Magnitude > 1 then dir = dir.Unit end
            hrp.AssemblyLinearVelocity = dir * C.FlySpeed
        end

        if C.SpeedOn and hum.WalkSpeed ~= C.Speed then hum.WalkSpeed = C.Speed end
        if C.JumpOn then
            if hum.UseJumpPower then
                if hum.JumpPower ~= C.Jump then hum.JumpPower = C.Jump end
            else
                hum.JumpHeight = (C.Jump * C.Jump) / (2 * workspace.Gravity)
            end
        end
    end

    BC.Track(RunService.Heartbeat:Connect(function()
        local ok, err = pcall(Step)
        if not ok and not warned then
            warned = true
            warn("[BayCollective] " .. tostring(err))
        end
    end))

    BC.Track(UIS.JumpRequest:Connect(function()
        if BC.Ready and C.InfJump and not State.Anchor then
            local _, _, hum = BC.GetChar()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end))

    BC.Track(LP.Idled:Connect(function()
        if not C.AntiAFK then return end
        pcall(function()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton2(Vector2.new())
        end)
    end))

    BC.Track(LP.CharacterAdded:Connect(function()
        State.Anchor, State.Locked, State.SafePos = false, nil, nil
        lastHum = nil
        BC.RefreshAll()
    end))

    BC.OnCleanup(function()
        BC.StopNoclip()
        BC.StopFly()
        BC.RestoreSpeed()
        BC.RestoreJump()
    end)

    -- ===== التشغيل =====
    local function launched()
        BC.Ready = true
        UI.Float.Visible = true
        UI.Open(true)
        local n = 0
        for _, k in ipairs({ "SpeedOn", "JumpOn", "InfJump", "Shield", "Guard", "Noclip", "Fly", "TapTP",
            "ESP", "FullBright", "FOVOn", "GravOn", "TimeOn" }) do
            if C[k] then n += 1 end
        end
        if BC.LoadedFromSave and n > 0 then
            BC.Notify("BAY COLLECTIVE", "رجّعنا إعداداتك: " .. n .. " ميزة شغّالة.", T.Green)
        else
            BC.Notify("BAY COLLECTIVE", "جاهز.. يلا جرّب.", T.A1)
        end
    end

    UI.Float.Visible = false
    if C.SkipIntro then
        launched()
    else
        BC.PlayIntro(launched)
    end
end
